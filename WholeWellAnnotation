
/*
 * ============================================================
 * CREATE ONE CONTOUR ANNOTATION AROUND THE ENTIRE WELL
 * Designed for the example .CTL images provided.
 *
 * Method:
 * 1. Read the full-resolution image.
 * 2. Convert it to grayscale.
 * 3. Smooth the image to reduce interference from dark spots.
 * 4. Threshold the smoothed image relative to the well center.
 * 5. Trace the outer boundary of the connected well region.
 * 6. Create one polygon annotation.
 * ============================================================
 */

import qupath.lib.regions.RegionRequest
import qupath.lib.regions.ImagePlane
import qupath.lib.roi.ROIs
import qupath.lib.objects.PathObjects
import ij.process.FloatProcessor
import ij.process.ByteProcessor
import ij.gui.Wand
import ij.plugin.filter.GaussianBlur

// ------------------------------------------------------------
// SETTINGS
// ------------------------------------------------------------

// Keep at 1.0 for full-resolution boundary detection.
double downsample = 1.0

// Gaussian smoothing in pixels.
// Higher values suppress more internal spot detail.
double blurSigma = 1.0

// Threshold offset above the smoothed center intensity.
// Increase to expand the contour; decrease to shrink it.
double thresholdOffset = 15.0

// Limits for the automatically calculated threshold.
double minimumThreshold = 245.0
double maximumThreshold = 250.0

// ------------------------------------------------------------
// GET IMAGE
// ------------------------------------------------------------

def imageData = getCurrentImageData()

if (imageData == null) {
    println "ERROR: No image is currently open."
    return
}

def server = imageData.getServer()
def hierarchy = imageData.getHierarchy()

int imageWidth = server.getWidth()
int imageHeight = server.getHeight()

println "Reading image..."

def request = RegionRequest.createInstance(
    server.getPath(),
    downsample,
    0,
    0,
    imageWidth,
    imageHeight
)

def img = server.readRegion(request)

if (img == null) {
    println "ERROR: Could not read the image."
    return
}

int width = img.getWidth()
int height = img.getHeight()

// ------------------------------------------------------------
// CONVERT TO GRAYSCALE
// ------------------------------------------------------------

float[] grayPixels = new float[width * height]

for (int y = 0; y < height; y++) {
    for (int x = 0; x < width; x++) {

        int rgb = img.getRGB(x, y)

        int red = (rgb >> 16) & 0xff
        int green = (rgb >> 8) & 0xff
        int blue = rgb & 0xff

        float gray = (float)(
            0.299 * red +
            0.587 * green +
            0.114 * blue
        )

        grayPixels[y * width + x] = gray
    }
}

FloatProcessor fp = new FloatProcessor(
    width,
    height,
    grayPixels
)

// ------------------------------------------------------------
// SMOOTH IMAGE
// ------------------------------------------------------------

println "Smoothing image..."

GaussianBlur blur = new GaussianBlur()

blur.blurGaussian(
    fp,
    blurSigma,
    blurSigma,
    0.01
)

// ------------------------------------------------------------
// CALCULATE THRESHOLD FROM WELL CENTER
// ------------------------------------------------------------

// The examples show the well centered in the image.
int centerX = (int)(width / 2)
int centerY = (int)(height / 2)

float centerIntensity = fp.getf(centerX, centerY)

double threshold = centerIntensity + thresholdOffset

threshold = Math.max(minimumThreshold, threshold)
threshold = Math.min(maximumThreshold, threshold)

println "Center intensity: ${centerIntensity}"
println "Calculated threshold: ${threshold}"

// ------------------------------------------------------------
// CREATE BINARY MASK
// ------------------------------------------------------------

// The well is darker than the white background.
// Smoothing helps keep internal spots connected to the
// main well region.

ByteProcessor mask = new ByteProcessor(width, height)

for (int y = 0; y < height; y++) {
    for (int x = 0; x < width; x++) {

        float value = fp.getf(x, y)

        if (value < threshold) {
            mask.set(x, y, 255)
        } else {
            mask.set(x, y, 0)
        }
    }
}

// ------------------------------------------------------------
// VERIFY CENTER IS INSIDE THE DETECTED WELL
// ------------------------------------------------------------

if (mask.get(centerX, centerY) != 255) {
    println "ERROR: The image center was not detected as part of the well."
    println "Check the image alignment or adjust the threshold settings."
    return
}

// ------------------------------------------------------------
// TRACE THE WELL CONTOUR
// ------------------------------------------------------------

println "Tracing well boundary..."

Wand wand = new Wand(mask)

wand.autoOutline(
    centerX,
    centerY,
    255,
    255
)

if (wand.npoints < 20) {
    println "ERROR: Could not find a valid well contour."
    return
}

// ------------------------------------------------------------
// CONVERT CONTOUR TO FULL-RESOLUTION COORDINATES
// ------------------------------------------------------------

double[] xPoints = new double[wand.npoints]
double[] yPoints = new double[wand.npoints]

for (int i = 0; i < wand.npoints; i++) {

    xPoints[i] = wand.xpoints[i] * downsample
    yPoints[i] = wand.ypoints[i] * downsample
}

// ------------------------------------------------------------
// CREATE ANNOTATION
// ------------------------------------------------------------

def plane = ImagePlane.getPlane(0, 0)

def roi = ROIs.createPolygonROI(
    xPoints,
    yPoints,
    plane
)

def annotation = PathObjects.createAnnotationObject(
    roi,
    getPathClass("Well")
)

// ------------------------------------------------------------
// ADD ANNOTATION TO QUPath
// ------------------------------------------------------------

hierarchy.addObject(annotation)

fireHierarchyUpdate()

println "=========================================="
println "SUCCESS: Whole-well contour annotation created."
println "Contour points: ${wand.npoints}"
println "Threshold used: ${threshold}"
println "=========================================="
