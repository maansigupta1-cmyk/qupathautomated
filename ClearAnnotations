// Remove all unlocked annotations from the current image

def imageData = getCurrentImageData()
def hierarchy = imageData.getHierarchy()

def annotations = hierarchy.getAnnotationObjects()

// Keep only annotations that are not locked
def unlockedAnnotations = annotations.findAll {
    !it.isLocked()
}

if (unlockedAnnotations.isEmpty()) {
    println "No unlocked annotations found. Nothing to clear."
} else {
    int count = unlockedAnnotations.size()

    hierarchy.removeObjects(unlockedAnnotations, true)
    fireHierarchyUpdate()

    println "Removed ${count} unlocked annotations."
    println "Locked annotations were preserved."
}
